# Downloaded FHIR bundles (large, re-downloaded on each run)
cache/

# Generated report files (produced fresh by each run / CI artifact upload)
reports/*.csv
reports/*.xlsx
reports/*.docx
reports/*.json
reports/*.log
!reports/.gitkeep

# Locally-generated reports at repo root (same reason)
dangling_refs_*.csv
dangling_summary_*.csv
orphan_refs_*.csv
placeholder_refs_*.csv
resource_counts_*.csv
reference_integrity_contract_*_report.xlsx
reference_integrity_contract_*_report.docx
validation_run.log
validation_run_*.log

# Per-run MPF change-detection artifacts -- state/mpf_state.json itself IS
# committed (it's the durable record); these are transient per-run files.
state/plan_result.json
state/state_*.json

# Never commit secrets
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
